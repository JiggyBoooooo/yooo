# Database
DATABASE_URL=postgresql://user:password@host:5432/sportabiedrs
DATABASE_SSL=true
DB_POOL_MAX=5

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Clerk server authentication
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_AUTHORIZED_PARTIES=https://sportabiedrs.lv

# Bookla provider adapter
# Use the exact URL template supplied by your Bookla integration.
# The default pattern mirrors the requested interface but is intentionally configurable.
BOOKLA_API_KEY=
BOOKLA_SLOTS_URL_TEMPLATE=https://bookla.com{external_id}/slots?date={date}
BOOKLA_HOLD_URL_TEMPLATE=
BOOKLA_RELEASE_URL_TEMPLATE=
BOOKLA_FINALIZE_URL_TEMPLATE=

# Playtomic provider adapter (optional)
PLAYTOMIC_API_KEY=
PLAYTOMIC_HOLD_URL_TEMPLATE=
PLAYTOMIC_RELEASE_URL_TEMPLATE=
PLAYTOMIC_FINALIZE_URL_TEMPLATE=

# Confirmation email via Resend
RESEND_API_KEY=
EMAIL_FROM=SportaBiedrs <bookings@sportabiedrs.lv>
